---
import Base from '../../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getRenderableCaseStudies, getRenderableMoments } from '../../lib/visibility';

export async function getStaticPaths() {
  const [entries, moments] = await Promise.all([
    getRenderableCaseStudies(),
    getRenderableMoments(),
  ]);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: moments.filter((m) => m.data.project === entry.id),
    },
  }));
}

interface Props {
  entry: CollectionEntry<'case-studies'>;
  related: CollectionEntry<'moments'>[];
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { title, summary, stack, role, org, problem, outcome, date } = entry.data;
---

<Base title={title} description={summary}>
  <p><a href="/case-studies">&larr; work</a></p>
  <h1>{title}</h1>
  <p class="lead">{summary}</p>

  <p class="meta mono">
    {org && <span>{org}</span>}
    {role && <span> · {role}</span>}
    <span> · {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</span>
  </p>
  <p>{stack.map((s) => <span class="tag">{s}</span>)}</p>

  <h2>Problem</h2>
  <p>{problem}</p>

  <Content />

  <h2>Outcome</h2>
  <p>{outcome}</p>

  {related.length > 0 && (
    <>
      <h2>Evidence</h2>
      <ul class="evidence">
        {related.map((m) => (
          <li>
            <strong>{m.data.title}</strong>
            {m.data.metrics.length > 0 && (
              <span class="evidence-metric">
                {m.data.metrics.map((x) => `${x.label}: ${x.value}`).join(' · ')}
              </span>
            )}
          </li>
        ))}
      </ul>
    </>
  )}
</Base>

<style>
  .meta {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }
  .evidence {
    list-style: none;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  .evidence li {
    padding: 0.4rem 0 0.4rem 1rem;
  }
  .evidence-metric {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-dim);
  }
</style>
