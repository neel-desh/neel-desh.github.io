---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getListedCaseStudies, getListedMoments } from '../../lib/visibility';

const caseStudies = await getListedCaseStudies();
const moments = await getListedMoments();

// Rollup by kind, in narrative order rather than alphabetical.
const KINDS = [
  { key: 'built', label: 'Built', blurb: 'Systems shipped end to end.' },
  { key: 'solved', label: 'Solved', blurb: 'Gaps closed, dead ends cleared.' },
  { key: 'scaled', label: 'Scaled', blurb: 'Taken to real production volume.' },
  { key: 'operated', label: 'Operated', blurb: 'On-call, incidents, aftermath.' },
  { key: 'learned', label: 'Learning', blurb: 'Picked up along the way.' },
] as const;

const rollup = KINDS.map((k) => ({
  ...k,
  items: moments.filter((m) => m.data.kind === k.key),
})).filter((k) => k.items.length > 0);

const titleOf = new Map(caseStudies.map((cs) => [cs.id, cs.data.title]));
---

<Base title="Work" description="Case studies and a record of what shipped - problems, architecture, outcomes.">
  <h1>Work</h1>
  <p class="lead">
    Two views of the same store. The deep dives below are written up in full;
    the record underneath is everything, indexed by what it counts as.
  </p>

  <h2>Deep dives</h2>
  {caseStudies.map((cs) => (
    <WorkCard
      entry={cs}
      evidence={moments.filter((m) => m.data.project === cs.id)}
      maxMetrics={3}
    />
  ))}

  <h2>Full record</h2>
  <p>
    Every entry is one dated, evidenced thing. The write-ups above are assembled
    from these, never maintained separately.
  </p>

  {rollup.map((group) => (
    <section class="rollup">
      <h3>
        {group.label}
        <span class="rollup-count">{group.items.length}</span>
      </h3>
      <p class="rollup-blurb">{group.blurb}</p>
      <ul class="moment-list">
        {group.items.map((m) => (
          <li id={m.id}>
            <div class="moment-head">
              {m.data.project ? (
                <a href={`/case-studies/${m.data.project}`}>{m.data.title}</a>
              ) : (
                <span>{m.data.title}</span>
              )}
              {m.data.project && titleOf.has(m.data.project) && (
                <span class="pill-kind">case study</span>
              )}
            </div>
            {m.data.metrics.length > 0 && (
              <div class="pill-row">
                {m.data.metrics.map((x) => (
                  <span class="pill-metric">{x.value}<span class="metric-label">{x.label}</span></span>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .rollup {
    margin: 2rem 0;
  }
  .rollup h3 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.2rem;
  }
  .rollup-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 0.45rem;
  }
  .rollup-blurb {
    color: var(--fg-dim);
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
  }
  .moment-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }
  .moment-list li {
    padding: 0.5rem 0 0.5rem 1rem;
    /* Arriving from a chat citation: clear the header, and mark which entry
       was cited so the landing is not a guess. */
    scroll-margin-top: 5rem;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .moment-list li:target {
    border-left-color: var(--accent);
    background: var(--bg-raised);
  }
  .moment-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .moment-list .pill-row {
    margin-top: 0.35rem;
  }
</style>
