---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

/**
 * The homepage is deliberately almost empty.
 *
 * The chat dock is the front door. A "Selected work" list here competed with
 * it - three cards restating what /work already holds, sitting between the
 * reader and the one thing this site does that a static profile cannot. The
 * record lives at /work, one click away and linked from every answer.
 */
---

<Base title="Home">
  <h1>Neel Deshmukh</h1>
  <p class="lead">
    Backend engineer, 4+ years on <strong>distributed</strong>,
    <strong>real-time</strong>, <strong>low-latency</strong> systems —
    market data, risk controls, and payments at
    <a href="https://github.com/punchhq">Punch</a>.
  </p>

  <p class="prompt-hint">
    Ask the box below about any of it, or read
    <a href="/case-studies">the record</a>.
  </p>

  {/* work/about are in the header already - only the profiles, which are not. */}
  <nav class="links" aria-label="Profiles">
    <a href="https://github.com/neel-desh" aria-label="GitHub"><Icon name="github" /></a>
    <a href="https://www.linkedin.com/in/neeldeshmukh/" aria-label="LinkedIn"><Icon name="linkedin" /></a>
  </nav>
</Base>

<style>
  .prompt-hint {
    color: var(--fg-dim);
    font-size: 0.95rem;
    margin: 1.5rem 0 0;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.5rem 0 0;
  }
  .links a {
    display: inline-flex;
    color: var(--fg-dim);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
