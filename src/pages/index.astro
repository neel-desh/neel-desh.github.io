---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

/**
 * The homepage is deliberately bare: who, what, and where to find the rest.
 * No chat dock (Base.astro skips it here) and no pointer to the work record -
 * the header nav already links work and about.
 */

const url = 'https://neeldeshmukh.com';
const person = {
  '@type': 'Person',
  '@id': `${url}/#person`,
  name: 'Neel Deshmukh',
  alternateName: ['neeldeshmukh', 'Neel Deshmukh backend engineer'],
  url,
  image: `${url}/og.png`,
  jobTitle: 'Backend Engineer',
  description:
    'Backend engineer with 5+ years building low-latency, fault-tolerant systems for a retail trading platform in Go and Elixir: market-data pipelines, trading risk controls, SSO and payments.',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Jai Hind College' },
  knowsAbout: [
    'Backend engineering',
    'Distributed systems',
    'Low-latency systems',
    'Real-time systems',
    'Fault-tolerant systems',
    'Elixir',
    'OTP',
    'Go',
    'Ruby',
    'Phoenix',
    'NATS JetStream',
    'PostgreSQL',
    'TimescaleDB',
    'Redis',
    'WebSockets',
    'Order management systems',
    'Market data',
    'System design',
    'Generative AI',
    'Agentic AI',
    'Claude Code',
    'Model Context Protocol',
    'Prompt engineering',
  ],
  sameAs: ['https://github.com/neel-desh', 'https://www.linkedin.com/in/neeldeshmukh/'],
};
const jsonLd = [
  { '@context': 'https://schema.org', ...person },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${url}/#website`,
    url,
    name: 'Neel Deshmukh',
    alternateName: 'neeldeshmukh.com',
    author: { '@id': `${url}/#person` },
    inLanguage: 'en',
  },
];
---

<Base
  title="Neel Deshmukh | Backend Engineer, Distributed Systems & Gen AI"
  description="Neel Deshmukh (neeldeshmukh) is a backend engineer with 5+ years building low-latency, fault-tolerant systems in Go and Elixir for a retail trading platform. Risk controls, market data, SSO and payments. Open to Gen AI and senior backend roles."
  jsonLd={jsonLd}
>
  <h1>Neel Deshmukh</h1>
  <p class="lead">
    Backend engineer, 5+ years on <strong>distributed</strong>,
    <strong>real-time</strong>, <strong>low-latency</strong> systems -
    market data, risk controls, and payments on a retail trading platform.
  </p>

  <nav class="links" aria-label="Profiles">
    <a href="https://github.com/neel-desh" aria-label="GitHub"><Icon name="github" /></a>
    <a href="https://www.linkedin.com/in/neeldeshmukh/" aria-label="LinkedIn"><Icon name="linkedin" /></a>
  </nav>
</Base>

<style>
  .links {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.5rem 0 0;
  }
  .links a {
    display: inline-flex;
    color: var(--fg-dim);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
