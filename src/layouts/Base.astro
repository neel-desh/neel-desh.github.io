---
import '../styles/global.css';
import TerminalIntro from '../components/TerminalIntro.astro';
import Chat from '../components/Chat.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Neel Deshmukh — backend & distributed systems engineer.' } = Astro.props;
const current = Astro.url.pathname;

// The chat dock is fixed to the viewport, so it belongs on every page rather
// than one section of the homepage. Capture is the exception: it is an
// authoring surface, and a reader-facing chat has no business on it.
const showChat = !current.startsWith('/capture');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Neel Deshmukh</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <TerminalIntro />
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href="/">neel deshmukh</a>
        <nav class="site-nav">
          <a href="/" aria-current={current === '/' ? 'page' : undefined}>home</a>
          <a href="/case-studies" aria-current={current.startsWith('/case-studies') ? 'page' : undefined}>work</a>
          <a href="/about" aria-current={current === '/about' ? 'page' : undefined}>about</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>&copy; {new Date().getFullYear()} Neel Deshmukh</span>
        <span class="footer-icons">
          <a href="https://github.com/neel-desh" aria-label="GitHub"><Icon name="github" size={15} /></a>
          <a href="https://www.linkedin.com/in/neeldeshmukh/" aria-label="LinkedIn"><Icon name="linkedin" size={15} /></a>
        </span>
      </footer>
    </div>
    {showChat && <Chat />}
  </body>
</html>
