---
import '../styles/global.css';
import TerminalIntro from '../components/TerminalIntro.astro';
import ViewToggle from '../components/ViewToggle.astro';
import RolesBanner from '../components/RolesBanner.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** Open Graph type. Case studies pass "article". */
  ogType?: 'website' | 'article';
  /** Structured data, one schema.org object per entry. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'Neel Deshmukh (neeldeshmukh) is a backend engineer with 5+ years building low-latency, fault-tolerant systems in Go and Elixir, open to Gen AI and senior backend roles.',
  ogType = 'website',
  jsonLd = [],
} = Astro.props;
const current = Astro.url.pathname;

// Every page carries the name once, so a title that already has it (the
// homepage) is used as written rather than getting it appended twice.
const fullTitle = title.includes('Neel Deshmukh') ? title : `${title} · Neel Deshmukh`;

// Canonical always ends in a slash, matching what the sitemap emits. Two
// spellings of one URL split the ranking signal between them.
const path = current.endsWith('/') ? current : `${current}/`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={`${canonical}index.md`} />
    <meta name="author" content="Neel Deshmukh" />
    <meta name="theme-color" content="#0b0d0f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="me" href="https://github.com/neel-desh" />
    <link rel="me" href="https://www.linkedin.com/in/neeldeshmukh/" />

    <meta property="og:site_name" content="Neel Deshmukh" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Neel Deshmukh, backend engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <TerminalIntro />
    <ViewToggle />
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href="/">neel deshmukh</a>
        <nav class="site-nav">
          <a href="/" aria-current={current === '/' ? 'page' : undefined}>home</a>
          <a href="/experience" aria-current={current.startsWith('/experience') ? 'page' : undefined}>experience</a>
          <a href="/about" aria-current={current === '/about' ? 'page' : undefined}>about</a>
        </nav>
      </header>
      <RolesBanner />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>&copy; {new Date().getFullYear()} Neel Deshmukh</span>
        <span class="footer-icons">
          <a href="https://github.com/neel-desh" aria-label="GitHub"><Icon name="github" size={15} /></a>
          <a href="https://www.linkedin.com/in/neeldeshmukh/" aria-label="LinkedIn"><Icon name="linkedin" size={15} /></a>
        </span>
      </footer>
    </div>
  </body>
</html>
