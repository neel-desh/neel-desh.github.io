---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  data-icon={name}
><title>{LABELS[name]}</title><path d={PATHS[name]} /></svg>
