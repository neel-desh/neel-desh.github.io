---
/**
 * Inline SVG icons. Inline rather than sprited or fetched: there are two of
 * them, and they use currentColor so they follow link colour for free in both
 * themes without a second definition.
 */
interface Props {
  name: 'github' | 'linkedin';
  size?: number;
}
const { name, size = 18 } = Astro.props;

const PATHS: Record<Props['name'], string> = {
