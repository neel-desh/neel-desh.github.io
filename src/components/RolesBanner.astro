---
// A nudge, not a banner ad: one quiet card in the content column, under the
// header. No dismiss button, no sticky positioning, nothing that follows the
// reader down the page.
---

<aside class="roles" aria-label="Availability">
  <p class="roles-text">
    <span class="dot" aria-hidden="true"></span>
    <span>Open to <strong>Gen AI</strong> and <strong>senior backend</strong> roles</span>
  </p>
  <a class="roles-link" href="/resume">Resume <span aria-hidden="true">&rarr;</span></a>
</aside>

<style>
  .roles {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: -1.25rem 0 2.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--accent-dim);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .roles-text {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--fg);
  }
  .roles-text strong {
    font-weight: 600;
  }
  .dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .roles-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .roles-link:hover {
    text-decoration: underline;
  }
</style>
